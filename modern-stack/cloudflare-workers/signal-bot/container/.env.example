# Signal Bot Container Environment Variables
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git!
#

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Signal phone number (with country code)
# Example: +19108471202
SIGNAL_PHONE_NUMBER=

# Worker API URL (your deployed Cloudflare Worker)
# Example: https://signal-cli-bot.YOUR-SUBDOMAIN.workers.dev
WORKER_API_URL=

# Worker API authentication token
# Generate with: openssl rand -base64 32
WORKER_API_TOKEN=

# ============================================================================
# SIGNAL CLI CONFIGURATION
# ============================================================================

# Signal CLI data directory (where account data is stored)
SIGNAL_CLI_CONFIG_DIR=/app/signal-data

# ============================================================================
# AI FEATURES (Optional)
# ============================================================================

# Enable OpenAI integration (!ai command)
OPENAI_ACTIVE=false

# OpenAI API key (required if OPENAI_ACTIVE=true)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Local AI URL (alternative to OpenAI)
# LOCAL_AI_URL=http://localhost:8080

# Local AI API key
# LOCAL_AI_API_KEY=

# ============================================================================
# DISCOURSE INTEGRATION (Optional)
# ============================================================================

# Discourse forum URL
# DISCOURSE_API_URL=https://your-forum.com

# Discourse API key
# DISCOURSE_API_KEY=

# Discourse API username (usually 'system')
# DISCOURSE_API_USERNAME=system

# ============================================================================
# CONTAINER CONFIGURATION
# ============================================================================

# Server port (default: 8080)
PORT=8080

# Auto-start bot on container startup
# Set to 'true' for production
AUTO_START=false

# Environment (development, staging, production)
MODE=development

# ============================================================================
# AUTHENTIK SSO INTEGRATION (Optional - for !createuser and !accountinvite)
# ============================================================================

# Authentik SSO base URL
# Example: https://sso.irregularchat.com
AUTHENTIK_BASE_URL=

# Authentik API token (generate in Authentik admin > Directory > Tokens)
AUTHENTIK_API_TOKEN=

# Authentik invite flow ID (UUID from Flows > invite-enrollment-flow)
# Get this from: Authentik Admin > Flows & Stages > Flows > invite-enrollment-flow > copy UUID from URL
AUTHENTIK_INVITE_FLOW_ID=

# Authentik invite flow slug (usually 'invite-enrollment-flow')
AUTHENTIK_INVITE_FLOW_SLUG=invite-enrollment-flow

# Main group ID for new users (optional)
# MAIN_GROUP_ID=

# ============================================================================
# EXAMPLE FILLED VALUES (for reference)
# ============================================================================
# DO NOT USE THESE - REPLACE WITH YOUR OWN!
#
# SIGNAL_PHONE_NUMBER=+19108471202
# WORKER_API_URL=https://signal-cli-bot.my-subdomain.workers.dev
# WORKER_API_TOKEN=abc123def456...
# OPENAI_ACTIVE=true
# OPENAI_API_KEY=sk-proj-...
# AUTO_START=true
# MODE=production
