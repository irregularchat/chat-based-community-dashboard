{
  "name": "signal-bot-container",
  "version": "3.0.0",
  "description": "Signal CLI Bot for Cloudflare Container - Fully integrated with D1, R2, Workers",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "docker:build": "docker build -t signal-cli-bot:latest .",
    "docker:run": "docker run -p 8080:8080 --env-file .env signal-cli-bot:latest",
    "docker:push": "docker push signal-cli-bot:latest",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "openai": "^5.16.0",
    "cheerio": "^1.1.2",
    "pdf-parse": "^1.1.1",
    "libphonenumber-js": "^1.12.9",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
