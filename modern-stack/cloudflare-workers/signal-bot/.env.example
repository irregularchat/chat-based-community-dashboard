# Signal Bot Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to version control

# ============================================================
# CLOUDFLARE WORKER DEPLOYMENT (use wrangler secrets)
# ============================================================
# For Cloudflare Workers, use: wrangler secret put VARIABLE_NAME
# These should NOT be stored in .env files in production

# Required: Signal bot phone number (E.164 format)
# Example: +19108471202
SIGNAL_PHONE_NUMBER=

# Optional: OpenAI API key for AI-powered responses
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Database connection for Hyperdrive (if using)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# ============================================================
# SELF-HOSTED DEPLOYMENT (use .env file)
# ============================================================
# For self-hosted deployments on Proxmox/Docker

# Database Configuration
# Generate a strong password using: openssl rand -base64 32
DB_PASSWORD=your_secure_database_password_here

# Signal Configuration
# Your Signal phone number in E.164 format (e.g., +12125551234)
SIGNAL_PHONE=+1234567890

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# Note: Use gpt-4o-mini until GPT-5 is available
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Discourse Forum Integration
# Get your API key from: https://your-forum.com/admin/api/keys
DISCOURSE_URL=https://forum.example.com
DISCOURSE_API_KEY=your_discourse_api_key_here
DISCOURSE_USERNAME=your_discourse_username

# Admin Phone Numbers (CVE-2025-001 Fix)
# Comma-separated list of admin phone numbers in E.164 format
# Example: +19108471202,+12247253276
ADMIN_PHONE_NUMBERS=+1234567890,+0987654321

# Domain Allowlist for URL Summarization (CVE-2025-002 Fix)
# Comma-separated list of allowed domains for !summarize command
# Leave empty to allow all domains (not recommended for security)
# Example: irregularchat.com,github.com,wikipedia.org
SUMMARIZE_ALLOWED_DOMAINS=

# Optional: Proxmox Host for Self-Hosted Deployment
# Default: root@proxmox-main
# PROXMOX_HOST=root@proxmox-main

# ============================================================
# SECURITY NOTES
# ============================================================
# 1. NEVER commit .env files with real credentials to git
# 2. Add .env to your .gitignore (should already be there)
# 3. Rotate API keys immediately if accidentally exposed
# 4. Use strong, randomly generated passwords (min 32 chars)
# 5. For Cloudflare Workers, use wrangler secrets instead of .env files
